name: Android CI

on:
  push:
    branches: ["**"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build, test & package
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"
          validate-wrappers: false

      - name: Unit tests (crypto / protocol)
        run: gradle --no-daemon testDebugUnitTest

      - name: Build debug APK
        run: gradle --no-daemon assembleDebug

      - name: Build release APK
        run: gradle --no-daemon assembleRelease

      - name: Rename artifacts
        run: |
          mkdir -p out
          VERSION=$(grep -oP 'versionName\s*=\s*"\K[^"]+' app/build.gradle.kts | head -1)
          cp app/build/outputs/apk/debug/app-debug.apk "out/Ping-$VERSION-debug.apk" || true
          cp app/build/outputs/apk/release/app-release.apk "out/Ping-$VERSION.apk" || true
          ls -lh out

      - name: Upload APKs
        uses: actions/upload-artifact@v4
        with:
          name: ping-apks
          path: out/*.apk
          if-no-files-found: error
          retention-days: 90

      - name: Publish rolling release (main only)
        if: github.ref == 'refs/heads/main' && github.event_name == 'push'
        continue-on-error: true
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          VERSION=$(grep -oP 'versionName\s*=\s*"\K[^"]+' app/build.gradle.kts | head -1)
          gh release delete latest --yes --cleanup-tag || true
          gh release create latest "out/Ping-$VERSION.apk" "out/Ping-$VERSION-debug.apk" \
            --title "Ping $VERSION (latest build)" \
            --notes "Automatic build of the latest \`main\`. Download **Ping-$VERSION.apk** and install it on your Android phone." \
            --prerelease
