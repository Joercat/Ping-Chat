<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the system draws the splash screen from the app theme itself. -->
<resources>
    <style name="Theme.Ping" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/dark_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/primary_purple</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
</resources>
